{
  "name": "flow-board",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "db:generate": "pnpm --filter @flow/server db:generate",
    "db:migrate": "pnpm --filter @flow/server db:migrate",
    "db:studio": "pnpm --filter @flow/server db:studio"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "^2.11.6",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.11.2"
}
